# LLM keys (both recommended for split supervisor / spoke models)
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional model overrides (defaults shown)
SUPERVISOR_MODEL=gpt-4o-mini
SPOKE_MODEL=gemini-3.6-flash

# Live ops tools
FLIGHTAWARE_API_KEY=your_flightaware_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# OpenSky Network OAuth (preferred) — from your OpenSky account API client
OPENSKY_CLIENT_ID=your_opensky_client_id_here
OPENSKY_CLIENT_SECRET=your_opensky_client_secret_here

# Optional legacy basic auth (only if you still use username/password)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Optional Mem0 fact-extraction model (defaults to SUPERVISOR_MODEL / gpt-4o-mini).
# Do not use gpt-5-mini here — Mem0's default temperature=0.1 is rejected by that model.
MEM0_LLM_MODEL=gpt-4o-mini

# Optional LangSmith live tracing
# Use the API host for your LangSmith region (US default / EU / APAC).
# Wrong region → 403 on /sessions and /runs/multipart even with a valid key.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://apac.api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=FinalApproach
